# =============================================================================
#  Global FUT Services — environment
#
#  Copy to .env and fill in. .env is git-ignored; keep it that way.
#
#  Generate the three secrets below with:
#
#     openssl rand -base64 48      # GFS_JWT_SECRET
#     openssl rand -base64 48      # GFS_QUOTE_SECRET
#     openssl rand -base64 32      # GFS_CREDENTIAL_MASTER_KEY  (exactly 32 bytes)
#
#  Use different values for each, and different values per environment. The
#  application refuses to start if any of them is missing — that is deliberate.
#  A service that boots with a placeholder key is a service that stores customer
#  passwords it cannot protect.
# =============================================================================

# --- database ----------------------------------------------------------------
GFS_DB_URL=jdbc:postgresql://localhost:5432/gfs
GFS_DB_USER=gfs
GFS_DB_PASSWORD=change-me-locally

# --- secrets (no defaults; startup fails without them) -----------------------
GFS_JWT_SECRET=
GFS_QUOTE_SECRET=
GFS_CREDENTIAL_MASTER_KEY=

# --- first operator account (used once, on first boot) -----------------------
# Clear these after the account exists.
GFS_BOOTSTRAP_ADMIN_EMAIL=
GFS_BOOTSTRAP_ADMIN_PASSWORD=

# --- site --------------------------------------------------------------------
GFS_SEASON=FC26
GFS_SEASON_YEAR=26
GFS_PUBLIC_URL=http://localhost:5173
GFS_CORS_ORIGINS=http://localhost:5173
GFS_CURRENCIES=INR
# Set true in every deployed environment. Marks session cookies Secure and emits HSTS.
GFS_REQUIRE_HTTPS=false

# --- pricing -----------------------------------------------------------------
GFS_MARKET_TAX_BPS=500          # EA transfer market tax, 5%
GFS_GATEWAY_FEE_BPS=250         # payment processing, 2.5%
GFS_GATEWAY_FEE_MODE=PASS_THROUGH   # ABSORBED | PASS_THROUGH | GROSS_UP

# The six-tier loyalty ladder (Bronze -> Diamond) discounting orders automatically.
#
# This STACKS with the points rebate. A Diamond customer redeeming their balance
# costs roughly 6% of gross between the two — 5% tier discount plus the ~1%
# effective rebate. That is a margin decision, so it is a switch rather than a
# redeploy: set it to false and the discount and its quote line both disappear,
# while points, tiers and statuses carry on accruing untouched.
GFS_PRICING_TIER_DISCOUNT_ENABLED=true

# --- loyalty -----------------------------------------------------------------
# Daily check-in grant. Zero disables the feature entirely.
GFS_LOYALTY_DAILY_BONUS_POINTS=3
# The zone whose midnight ends a loyalty day. Deliberately NOT UTC: with a UTC
# boundary an Indian customer's day rolls over at 05:30 local, so two check-ins
# the same evening-and-morning count as two days while two at 9am on consecutive
# days count as one.
GFS_LOYALTY_BONUS_ZONE=Asia/Kolkata

# --- coaching ----------------------------------------------------------------
# Booking rules. These are published promises on the coaching page and lines in
# the Terms, so they live here rather than in booking logic.
GFS_COACHING_SESSION_LENGTH=40m
GFS_COACHING_SLOT_STEP=30m       # booking grid: slots start on the hour and half hour
GFS_COACHING_MIN_LEAD_TIME=2h    # how soon before a slot it may still be booked
GFS_COACHING_MAX_ADVANCE=60d     # how far ahead the calendar is open
GFS_COACHING_CHANGE_CUTOFF=12h   # notice needed to move or cancel and keep the credit
GFS_COACHING_MAX_RESCHEDULES=2
GFS_COACHING_NO_SHOW_GRACE=15m
GFS_COACHING_CREDIT_VALIDITY=30d
# Sessions granted per rate-card variant. A new pack is a rate-card row plus a
# line here, not a code change.
GFS_COACHING_CREDITS_PER_VARIANT=SINGLE_SESSION:1,MONTHLY_6_SESSIONS:6

# --- razorpay ----------------------------------------------------------------
# Leave disabled for local development: checkout still works end to end against a
# stub, so the whole flow can be exercised without live credentials.
#
# The webhook secret is NOT the API key secret. It is set separately in the
# Razorpay dashboard when you register the webhook endpoint. Without it, paid
# orders are never marked paid — the application warns loudly about this at
# startup.
GFS_RAZORPAY_ENABLED=false
GFS_RAZORPAY_KEY_ID=
GFS_RAZORPAY_KEY_SECRET=
GFS_RAZORPAY_WEBHOOK_SECRET=

# --- social sign-in ------------------------------------------------------------
# Optional. Leave all four blank and the register page shows a plain password form
# with no social buttons — the frontend asks the backend which providers exist and
# renders only those, so a half-configured provider never appears as a button that
# fails after the customer has already left the site.
#
# Both consoles need the callback URL for whatever host is running:
#   http://localhost:8080/login/oauth2/code/google
#   http://localhost:8080/login/oauth2/code/discord
# and in production the same two paths on the API host, over https.
#
# The client IDs are public — they travel in the redirect URL and are safe to paste
# anywhere. The two secrets are not: never in the repo, never over chat or email.
GFS_GOOGLE_CLIENT_ID=
GFS_GOOGLE_CLIENT_SECRET=
GFS_DISCORD_CLIENT_ID=
GFS_DISCORD_CLIENT_SECRET=

# --- coin fulfilment (FUT Transfer) --------------------------------------------
# The supplier that actually moves the coins.
#
# Disabled is a supported state: orders stop at READY_FOR_DELIVERY for an operator to
# work by hand, exactly as they did before this integration existed. That is what makes
# it safe to switch off during a supplier incident.
#
# API-KEY is the RAW key as the supplier issued it. Their API wants an MD5 of it in every
# request body; that digest is computed per request, so nobody has to paste a hash.
# The digest is a static bearer secret with no nonce or expiry — treat the raw key exactly
# like a password.
GFS_FUTTRANSFER_ENABLED=false
GFS_FUTTRANSFER_BASE_URL=https://futtransfer.top
GFS_FUTTRANSFER_API_USER=
GFS_FUTTRANSFER_API_KEY=

# snipe (default) | cycle | targetedSnipe | snipeLimited
GFS_FUTTRANSFER_METHOD=snipe

# 1 = maximum safety … 6 = "ban mode".
#
# LEAVE THIS AT 2. The supplier documents 3 and above as escalating ban risk with NO
# REFUNDS, and this storefront sells a seven-day ban guarantee on every order — above 2
# you are underwriting a promise your supplier has explicitly declined to back.
GFS_FUTTRANSFER_RISK_LEVEL=2

# --- notifications -------------------------------------------------------------
#
# WHO GETS TOLD WHEN AN ORDER IS PAID.
#
# If none of the three channels below is switched on, nobody is alerted and paid
# orders sit unfulfilled until somebody happens to open the console. The app logs a
# WARN at startup when that is the case — check for it after any deploy:
#
#   "NO notification channels are enabled ..."
#
# Start with email. It is the only one that needs no approval from anybody.


# --- 1. Email (recommended, works today) ----------------------------------------
# SMTP only: no Meta business verification, no message template to get approved.
# Two settings make it live: GFS_EMAIL_ENABLED and GFS_OPERATOR_EMAILS. Enabling
# one without the other does nothing at all — the notifier needs a recipient.
#
# Subjects are prefixed so an inbox stays sortable, and so a phone filter can be
# pointed at just the urgent one:
#   [ACTION]   paid and waiting to be fulfilled   <- the one that matters
#   [WAITING]  paid, but blocked on the customer's sign-in
#   (none)     placed but not yet paid, informational
#
# Put a phone rule on "[ACTION]" and email behaves like a push notification.

GFS_EMAIL_ENABLED=false
# Comma-separated. Everyone here gets every alert.
GFS_OPERATOR_EMAILS=
GFS_EMAIL_FROM=orders@globalfutservices.com

# SMTP host. The defaults below point at a local catcher for development.
GFS_SMTP_HOST=localhost
GFS_SMTP_PORT=1025
GFS_SMTP_USER=
GFS_SMTP_PASSWORD=
GFS_SMTP_AUTH=false
GFS_SMTP_TLS=false

# -- Gmail, with an app password ------------------------------------------------
# Fine for alerting one or two operators; the send limit is far above what order
# volume will need. Requires 2-Step Verification on the account, then an App
# Password (Google Account -> Security -> App passwords). Your normal Gmail
# password will not work and should never be put here.
#
#   GFS_SMTP_HOST=smtp.gmail.com
#   GFS_SMTP_PORT=587
#   GFS_SMTP_USER=youraddress@gmail.com
#   GFS_SMTP_PASSWORD=<16-character app password>
#   GFS_SMTP_AUTH=true
#   GFS_SMTP_TLS=true
#   GFS_EMAIL_FROM=youraddress@gmail.com     # Gmail rewrites a mismatched From
#
# -- A transactional provider (better if alerts ever go to customers too) --------
# Brevo, Resend, Mailgun and SES all have free tiers and give you delivery logs,
# which Gmail does not. Same shape:
#
#   GFS_SMTP_HOST=smtp-relay.brevo.com
#   GFS_SMTP_PORT=587
#   GFS_SMTP_USER=<provider login>
#   GFS_SMTP_PASSWORD=<provider key>
#   GFS_SMTP_AUTH=true
#   GFS_SMTP_TLS=true


# --- 2. Telegram (instant push, no onboarding) ----------------------------------
# A real phone push in about five minutes, with no business verification. Setup:
#   1. Message @BotFather on Telegram, send /newbot, copy the token below.
#   2. Send your new bot any message from the phone that should get the alerts —
#      a bot cannot open a conversation, the human has to speak first.
#   3. GET https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#      result[0].message.chat.id into GFS_TELEGRAM_CHAT_ID.
# Use a negative id (a group's) if more than one person should be on call.
GFS_TELEGRAM_ENABLED=false
GFS_TELEGRAM_TOKEN=
GFS_TELEGRAM_CHAT_ID=


# --- 3. WhatsApp Cloud API (most work to switch on) -----------------------------
# Needs, in order: a verified Meta Business account, a WhatsApp Business number
# that is not already on regular WhatsApp, a permanent access token, and an
# APPROVED message template named below with exactly four body placeholders
# (headline, order ref, service, amount). The template is the real gate — operator
# alerts fall outside the 24-hour customer-initiated window, so a free-form message
# will not deliver, and Meta reviews templates before they can be used.
#
# Use the official Cloud API and nothing else. The libraries that drive a personal
# WhatsApp account get numbers banned.
GFS_WHATSAPP_ENABLED=false
GFS_WHATSAPP_PHONE_ID=
GFS_WHATSAPP_TOKEN=
# E.164 without the plus, e.g. 917339744705
GFS_WHATSAPP_TO=
GFS_WHATSAPP_TEMPLATE=gfs_new_order
GFS_SMTP_AUTH=false
GFS_SMTP_TLS=false

# --- misc --------------------------------------------------------------------
GFS_PORT=8080
GFS_LOG_LEVEL=INFO
# Turn the interactive API docs off in production: an endpoint catalogue is a
# gift to anyone probing the service.
GFS_SWAGGER_ENABLED=true

# --- frontend (read at build time by Vite) -----------------------------------
VITE_API_BASE_URL=http://localhost:8080
